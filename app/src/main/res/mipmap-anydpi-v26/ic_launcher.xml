<?xml version="1.0" encoding="utf-8"?><!--
  Comfort adaptive icon.

  Both layers are generated by tools/icon.py from the supplied Comfort logo
  (app/icon-src/comfort-logo.png). The background is the logo plate's flat
  colour; the foreground is the C-wave mark cropped from the supplied artwork
  and placed inside the 66dp adaptive safe zone. Splitting plate and mark this
  way means whatever mask the launcher applies cuts the plate, never a plate
  drawn inside the icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
