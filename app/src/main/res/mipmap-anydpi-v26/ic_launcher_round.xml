<?xml version="1.0" encoding="utf-8"?><!--
  Comfort round adaptive icon.

  The launcher masks this to a circle. Layers come from tools/icon.py, which
  builds them from the supplied Comfort logo (app/icon-src/comfort-logo.png):
  flat plate colour behind, the C-wave mark inside the safe zone in front.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
